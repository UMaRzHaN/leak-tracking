# Собранное руководство для Android. Исходник — docs/manual/android/ — лежит
# в репозитории; PDF из него печатает scripts/build-android-manual-pdf.mjs.
# Отслеживать сам PDF вышло дорого: четыре пересборки оставили в истории
# 40 МБ, и каждая следующая добавляла бы ещё десять — сжатый файл не жмётся
# паком и не складывается в дельту с предыдущей версией.
/docs/Leak-Tracker-Android-Manual.pdf

# misc
.DS_Store
/android/.idea/
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# agents
/.claude/settings.local.json

# Signing keys. A committed keystore is a compromised keystore: the history
# keeps it even after a delete, and anyone with the repo can sign a build that
# Android will accept as an update to the real app.
*.jks
*.keystore
*.p12
keystore.properties
