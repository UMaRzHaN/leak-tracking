{
  "name": "leak-tracking",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor-mlkit/barcode-scanning": "^8.1.0",
    "@capacitor/android": "^8.0.0",
    "@capacitor/camera": "^8.2.2",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/geolocation": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "i18next": "^23.16.8",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-i18next": "^13.5.0",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "build:analyze": "vite build --mode analyze",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:offline": "npm run build && playwright test --config=playwright.offline.config.mjs",
    "test:e2e:ui": "playwright test --ui",
    "test:perf": "npm run build && playwright test --config=playwright.performance.config.mjs",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "typecheck": "tsc -p tsconfig.check.json",
    "prepare": "husky",
    "postinstall": "node scripts/patch-gradle.js",
    "deps:refresh-lock": "npm install --package-lock-only --ignore-scripts",
    "check:install-scripts": "npm approve-scripts --allow-scripts-pending",
    "cap:sync": "npx cap sync && node scripts/patch-gradle.js",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "pack:source": "node scripts/pack-source.mjs --verify",
    "verify:release": "npm run check:clean && npm run lint && npm run format:check && npm run typecheck && npm run check:maintainability && npm run test:coverage && npm run check:coverage-ratchet && npm run build:analyze && npm run check:bundle && npm run check:licenses && npm run generate:sbom && npm run release:evidence:web && npm run artifacts:checksums:web",
    "android:release": "npm run check:clean && node scripts/verify-android-signing.mjs && npm run build && npm run cap:sync && npm run check:clean && cd android && ./gradlew test lintRelease assembleRelease && cd .. && npm run release:evidence:android && npm run artifacts:checksums:android",
    "test:e2e:cross-browser": "playwright test --config=playwright.cross-browser.config.mjs",
    "check:coverage-ratchet": "node scripts/check-coverage-ratchet.mjs",
    "generate:sbom": "node scripts/generate-sbom.mjs",
    "release:evidence:web": "node scripts/write-release-verification.mjs --scope=web",
    "release:evidence:android": "node scripts/write-release-verification.mjs --scope=android",
    "release:evidence:e2e": "node scripts/write-release-verification.mjs --scope=e2e",
    "check:licenses": "node scripts/check-license-policy.mjs",
    "check:maintainability": "node scripts/check-maintainability-budget.mjs",
    "check:clean": "node scripts/check-clean-worktree.mjs",
    "artifacts:checksums": "node scripts/write-artifact-checksums.mjs",
    "release:evidence:source": "node scripts/write-release-verification.mjs --scope=source",
    "artifacts:checksums:web": "node scripts/write-artifact-checksums.mjs .artifacts dist",
    "artifacts:checksums:source": "node scripts/write-artifact-checksums.mjs .artifacts",
    "artifacts:checksums:android": "node scripts/write-artifact-checksums.mjs .artifacts android/app/build/outputs/apk android/app/build/outputs/bundle",
    "artifacts:checksums:e2e": "node scripts/write-artifact-checksums.mjs .artifacts playwright-report test-results"
  },
  "lint-staged": {
    "src/**/*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{md,json,yml,yaml}": [
      "prettier --write"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@eslint-react/eslint-plugin": "^5.18.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "husky": "^9.1.7",
    "jsdom": "29.1.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "rollup-plugin-visualizer": "^7.0.1",
    "sass": "^1.97.3",
    "typescript": "^6.0.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "exceljs": {
      "archiver": "^8.0.0",
      "unzipper": "^0.12.5",
      "fast-csv": "5.0.7"
    },
    "uuid": "^11.1.1",
    "brace-expansion": "^5.0.9"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.60.2"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.4": true,
    "esbuild@0.25.12": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true
  }
}
