# Tile server base URL for offline map caching (ESRI World Imagery)
# Production deployments with sensitive locations should use an approved,
# preferably self-hosted tile server. Tile coordinates reveal the viewed area.
VITE_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile
# Required when using a non-Esri tile provider
VITE_TILE_ATTRIBUTION=

# Optional deployment subpath, for example /leak-tracking/
VITE_BASE_PATH=/

# Add other environment-specific variables here as the project grows
VITE_OFFLINE_MAP_ONLY=false
VITE_REQUIRE_PRIVATE_TILE_PROVIDER=false
